# Copy to .env and adjust.
# Local: your own MySQL 8 install. Hostinger: the database created in hPanel, host 127.0.0.1.
DATABASE_URL="mysql://udhay:change-me@127.0.0.1:3306/udhay"

PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
WEB_ORIGIN=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

# On Hostinger, point this OUTSIDE the deployed app folder so redeploys keep the files,
# e.g. /home/<user>/udhay-uploads
UPLOAD_DIR=./uploads

# Scheduled jobs (SLA alerts, cleanup). They run inside the API process every minute.
# Optional backup: an hPanel cron calling POST /api/jobs/run with header X-Jobs-Secret.
JOBS_SECRET=replace-with-another-long-random-secret
JOBS_IN_PROCESS=true
# Warn the stage owner this many hours before the due time
SLA_DUE_SOON_HOURS=4
# Escalate to Admin / Super Admin once a stage is overdue by this many hours
SLA_ESCALATE_AFTER_HOURS=24
# Read notifications older than this are deleted nightly
NOTIFICATION_RETENTION_DAYS=90
