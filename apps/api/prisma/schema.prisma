// Enum values for TeamCode, DocumentType and Scope must match
// packages/shared. The API asserts this at compile time (src/common/enum-sync.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TeamCode {
  MANAGEMENT
  SALES
  PROJECT
  OPERATIONS
  CAD
  PRODUCTION
  QC
  DISPATCH
  SERVICE
  ACCOUNTS
  PURCHASE
}

enum Scope {
  OWN
  TEAM
  ALL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  LOST
  COMPLETED
  CANCELLED
}

enum StageStatus {
  OPEN
  DONE
  RETURNED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentType {
  REQUIREMENT
  LAYOUT
  MEASUREMENT
  SITE_PHOTO
  QUOTATION
  PURCHASE_ORDER
  BOQ
  SOFT_DRAWING
  CUSTOMER_APPROVAL
  CAD
  QC_REPORT
  DELIVERY_CHALLAN
  POD
  INSTALLATION_PHOTO
  HANDOVER_CERT
  SERVICE_PHOTO
  OTHER
}

enum PaymentKind {
  ADVANCE
  PRE_DISPATCH
  FINAL
  OTHER
}

enum PaymentStatus {
  PENDING
  RECEIVED
  WAIVED
}

enum ItemStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
}

enum ProductionLevel {
  LASER_BENDING
  FABRICATION
  WELDING
  POLISH
}

enum QcStatus {
  PENDING
  PASSED
  FAILED
}

enum TripStatus {
  PLANNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum SnagStatus {
  OPEN
  RESOLVED
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ─── Identity & access ──────────────────────────────────────────────

model Team {
  id    String   @id @default(cuid())
  code  TeamCode @unique
  name  String
  users User[]
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  scope        Scope
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id                 String    @id @default(cuid())
  name               String
  /// Optional: staff can sign in with employee code or mobile number instead.
  email              String?   @unique
  phone              String?   @unique
  employeeCode       String?   @unique @db.VarChar(30)
  displayName        String?   @db.VarChar(80)
  gender             String?   @db.VarChar(20)
  department         String?   @db.VarChar(80)
  employmentType     String?   @db.VarChar(30)
  dateOfJoining      DateTime? @db.Date
  dateOfBirth        DateTime? @db.Date
  passwordHash       String
  /// Set for new or reset passwords; the user must choose their own before using the app.
  mustChangePassword Boolean   @default(false)
  isActive           Boolean   @default(true)
  roleId             String
  teamId             String?
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  role Role  @relation(fields: [roleId], references: [id])
  team Team? @relation(fields: [teamId], references: [id])

  refreshTokens     RefreshToken[]
  ownedProjects     Project[]          @relation("ProjectSalesOwner")
  createdProjects   Project[]          @relation("ProjectCreatedBy")
  assignedStages    ProjectStage[]     @relation("StageAssignee")
  acceptedStages    ProjectStage[]     @relation("StageAcceptedBy")
  transitions       StageTransition[]
  documents         Document[]
  comments          Comment[]
  createdCustomers  Customer[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  paymentsCreated   PaymentMilestone[] @relation("PaymentCreatedBy")
  paymentsRecorded  PaymentMilestone[] @relation("PaymentRecordedBy")
  qcChecks          ProductionItem[]   @relation("ItemQcBy")
  tripsCreated      DispatchTrip[]
  snagsRaised       Snag[]             @relation("SnagRaisedBy")
  snagsResolved     Snag[]             @relation("SnagResolvedBy")
  handovers         Handover[]
  ticketsRaised     ServiceTicket[]    @relation("TicketRaisedBy")
  ticketsAssigned   ServiceTicket[]    @relation("TicketAssignee")
  serviceVisits     ServiceVisit[]

  @@index([teamId])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @db.Char(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?   @db.VarChar(255)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Customers & projects ───────────────────────────────────────────

model Customer {
  id            String    @id @default(cuid())
  name          String
  contactPerson String?
  phone         String
  email         String?
  city          String?
  address       String?   @db.Text
  gstin         String?   @db.VarChar(20)
  isDemo        Boolean   @default(false)
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  createdBy User      @relation(fields: [createdById], references: [id])
  projects  Project[]

  @@index([name])
  @@index([phone])
}

model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  title          String
  customerId     String
  siteAddress    String?       @db.Text
  city           String?
  requirement    String?       @db.Text
  estimatedValue Decimal?      @db.Decimal(14, 2)
  priority       Priority      @default(NORMAL)
  status         ProjectStatus @default(ACTIVE)
  currentStage   String        @default("LEAD") @db.VarChar(40)
  currentTeam    TeamCode      @default(SALES)
  stageDueAt     DateTime?
  holdReason     String?       @db.Text
  salesOwnerId   String
  createdById    String
  closedAt       DateTime?
  /// Sample data from Settings, Demo data; removed together in one click.
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  customer      Customer           @relation(fields: [customerId], references: [id])
  salesOwner    User               @relation("ProjectSalesOwner", fields: [salesOwnerId], references: [id])
  createdBy     User               @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  stages        ProjectStage[]
  transitions   StageTransition[]
  documents     Document[]
  comments      Comment[]
  notifications Notification[]
  payments      PaymentMilestone[]
  items         ProductionItem[]
  trips         DispatchTrip[]
  snags         Snag[]
  handover      Handover?
  tickets       ServiceTicket[]

  @@index([status, currentStage])
  @@index([currentTeam, status])
  @@index([stageDueAt])
  @@index([customerId])
  @@index([salesOwnerId])
}

/// One row per visit of a project to a stage. Revisions create a new row (cycle 2, 3…).
model ProjectStage {
  id            String      @id @default(cuid())
  projectId     String
  stage         String      @db.VarChar(40)
  team          TeamCode
  cycle         Int         @default(1)
  status        StageStatus @default(OPEN)
  assigneeId    String?
  startedAt     DateTime    @default(now())
  acceptedAt    DateTime?
  acceptedById  String?
  dueAt         DateTime?
  completedAt   DateTime?
  /// Highest SLA alert already sent for this visit (0 none, 1 due soon, 2 overdue, 3 escalated to admins).
  slaAlertLevel Int         @default(0)

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee   User?   @relation("StageAssignee", fields: [assigneeId], references: [id])
  acceptedBy User?   @relation("StageAcceptedBy", fields: [acceptedById], references: [id])

  @@index([projectId, stage])
  @@index([status, team])
  @@index([status, dueAt])
  @@index([assigneeId, status])
}

model StageTransition {
  id        String   @id @default(cuid())
  projectId String
  fromStage String?  @db.VarChar(40)
  toStage   String?  @db.VarChar(40)
  action    String   @db.VarChar(40)
  reason    String?  @db.Text
  byUserId  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  byUser  User    @relation(fields: [byUserId], references: [id])

  @@index([projectId, createdAt])
  @@index([createdAt])
}

model Document {
  id           String       @id @default(cuid())
  projectId    String
  stage        String       @db.VarChar(40)
  type         DocumentType
  version      Int
  fileName     String
  storageKey   String       @db.VarChar(512)
  mimeType     String       @db.VarChar(150)
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([projectId, type])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  body      String?   @db.Text
  projectId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([createdAt])
}

/**
 * A phone or browser that receives web push for a user (one row per device).
 */
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(700)
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  userAgent String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  projectId String
  stage     String?  @db.VarChar(40)
  body      String   @db.Text
  /// User ids mentioned with @ in the body
  mentions  Json?
  authorId  String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId, createdAt])
}

// ─── System ─────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  entity    String   @db.VarChar(40)
  entityId  String
  action    String   @db.VarChar(60)
  data      Json?
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Lease-based lock + last-run record for scheduled jobs (safe across multiple app instances).
model JobLock {
  name        String    @id @db.VarChar(60)
  lockedUntil DateTime
  lastRunAt   DateTime?
  lastResult  Json?
  lastError   String?   @db.Text
}

model StageSetting {
  stage    String @id @db.VarChar(40)
  slaHours Int
}

model Counter {
  key   String @id
  value Int
}

// --- Phase 2: operations -------------------------------------------

model PaymentMilestone {
  id             String        @id @default(cuid())
  projectId      String
  kind           PaymentKind
  label          String        @db.VarChar(120)
  amount         Decimal       @db.Decimal(14, 2)
  dueDate        DateTime?
  status         PaymentStatus @default(PENDING)
  receivedAt     DateTime?
  receivedAmount Decimal?      @db.Decimal(14, 2)
  mode           String?       @db.VarChar(30)
  reference      String?       @db.VarChar(100)
  notes          String?       @db.Text
  recordedById   String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  recordedBy User?   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([projectId])
  @@index([status, dueDate])
  @@index([receivedAt])
}

/// One equipment item on the production floor (cooking range, sink unit, hood...).
model ProductionItem {
  id        String           @id @default(cuid())
  projectId String
  name      String           @db.VarChar(160)
  quantity  Int              @default(1)
  spec      String?          @db.Text
  status    ItemStatus       @default(NOT_STARTED)
  /// Level being worked on (Laser & Bending, Fabrication, Welding, Polish); null before work starts.
  level     ProductionLevel?
  progress  Int              @default(0)
  qcStatus  QcStatus         @default(PENDING)
  qcNotes   String?          @db.Text
  qcById    String?
  qcAt      DateTime?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  qcBy    User?   @relation("ItemQcBy", fields: [qcById], references: [id])

  @@index([projectId, sortOrder])
}

model DispatchTrip {
  id             String     @id @default(cuid())
  projectId      String
  tripNo         Int
  plannedDate    DateTime
  vehicleNo      String?    @db.VarChar(30)
  driverName     String?    @db.VarChar(120)
  driverPhone    String?    @db.VarChar(20)
  challanNo      String?    @db.VarChar(60)
  ewayBillNo     String?    @db.VarChar(60)
  itemsNote      String?    @db.Text
  status         TripStatus @default(PLANNED)
  dispatchedAt   DateTime?
  deliveredAt    DateTime?
  receivedByName String?    @db.VarChar(120)
  podDocumentId  String?
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@unique([projectId, tripNo])
  @@index([plannedDate, status])
}

model Snag {
  id           String     @id @default(cuid())
  projectId    String
  title        String     @db.VarChar(200)
  description  String?    @db.Text
  status       SnagStatus @default(OPEN)
  resolution   String?    @db.Text
  raisedById   String
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  raisedBy   User    @relation("SnagRaisedBy", fields: [raisedById], references: [id])
  resolvedBy User?   @relation("SnagResolvedBy", fields: [resolvedById], references: [id])

  @@index([projectId, status])
}

/// Signed handover. Warranty for service tickets is measured from here.
model Handover {
  id                    String   @id @default(cuid())
  projectId             String   @unique
  signedByName          String   @db.VarChar(120)
  signedByPhone         String?  @db.VarChar(20)
  signedAt              DateTime
  warrantyMonths        Int
  warrantyStart         DateTime
  warrantyEnd           DateTime
  trainingDone          Boolean  @default(false)
  notes                 String?  @db.Text
  certificateDocumentId String?
  recordedById          String
  createdAt             DateTime @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id])
}

model ServiceTicket {
  id            String       @id @default(cuid())
  code          String       @unique
  projectId     String
  title         String       @db.VarChar(200)
  description   String       @db.Text
  priority      Priority     @default(NORMAL)
  status        TicketStatus @default(OPEN)
  underWarranty Boolean      @default(false)
  contactName   String?      @db.VarChar(120)
  contactPhone  String?      @db.VarChar(20)
  assigneeId    String?
  raisedById    String
  dueAt         DateTime?
  slaAlerted    Boolean      @default(false)
  resolution    String?      @db.Text
  resolvedAt    DateTime?
  closedAt      DateTime?
  csatRating    Int?
  csatComment   String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  raisedBy User           @relation("TicketRaisedBy", fields: [raisedById], references: [id])
  visits   ServiceVisit[]

  @@index([status, dueAt])
  @@index([projectId])
  @@index([assigneeId, status])
  @@index([createdAt])
}

model ServiceVisit {
  id           String   @id @default(cuid())
  ticketId     String
  technicianId String
  visitDate    DateTime
  workDone     String   @db.Text
  partsUsed    String?  @db.Text
  createdAt    DateTime @default(now())

  ticket     ServiceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  technician User          @relation(fields: [technicianId], references: [id])

  @@index([ticketId, visitDate])
}

/// Business rules editable in Settings (payment gates, warranty, ticket response times).
model AppSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt
}
